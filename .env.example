# ===== Supabase (Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_anon_public_key
# RAHASIA: hanya untuk server. Jangan diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key

# ===== Token QR (string acak panjang, minimal 32 karakter) =====
QR_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# ===== Chatbot AI (opsional). Tanpa kunci, chatbot memakai jawaban otomatis dari data =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Dipakai script seed:admin =====
ADMIN_EMAIL=admin@sekolah.test
ADMIN_PASSWORD=GantiPasswordIni123
ADMIN_NAMA=Administrator
